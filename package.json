{
	"name": "glitch-studio",
	"private": true,
	"version": "2.0.0-alpha.26",
	"packageManager": "pnpm@12.3.4",
	"workspaces": [
		"docs-site",
		"packages/shared",
		"packages/subsystems/audio/shared",
		"packages/subsystems/audio/renderer",
		"packages/subsystems/effect/shared",
		"packages/subsystems/effect/renderer",
		"packages/subsystems/visual-module/shared",
		"packages/subsystems/visual-module/renderer",
		"packages/subsystems/timeline/shared",
		"packages/subsystems/timeline/renderer",
		"packages/subsystems/timeline/audio-renderer",
		"packages/glitch-studio/shared",
		"packages/glitch-studio/renderer",
		"packages/glitch-studio/ui",
		"packages/glitch-studio/desktop"
	],
	"scripts": {
		"test": "pnpm --no-bail -r test",
		"dev": "pnpm --dir packages/glitch-studio/ui dev",
		"build": "pnpm --dir packages/glitch-studio/ui build",
		"preview": "pnpm --dir packages/glitch-studio/ui preview",
		"docs:dev": "pnpm --dir docs-site dev",
		"docs:build": "pnpm --dir docs-site build",
		"docs:preview": "pnpm --dir docs-site preview",
		"typecheck": "pnpm --no-bail -r typecheck",
		"lint": "pnpm --no-bail -r lint",
		"dev:desktop": "pnpm --dir packages/glitch-studio/desktop dev",
		"build:desktop": "cross-env BUILD_TARGET=electron pnpm --dir packages/glitch-studio/ui build",
		"start:desktop": "pnpm --dir packages/glitch-studio/desktop start",
		"dist:desktop:win": "pnpm build:desktop && pnpm --dir packages/glitch-studio/desktop dist:win",
		"dist:desktop:mac": "pnpm build:desktop && pnpm --dir packages/glitch-studio/desktop dist:mac"
	},
	"dependencies": {
		"esbuild": "0.28.2"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@misskey-dev/eslint-plugin": "2.2.1",
		"@types/node": "26.6.5",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"cross-env": "10.1.0",
		"eslint": "9.39.5",
		"globals": "17.13.0",
		"typescript": "npm:@typescript/typescript6@6.0.2"
	}
}

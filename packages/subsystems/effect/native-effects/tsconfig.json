{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"strictFunctionTypes": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"rootDir": "..",
		"lib": [
			"esnext"
		],
		"types": [
			"@types/web",
			"vite/client",
			"@gs/shared/wgsl-imports"
		]
	},
	"include": [
		"src/**/*.ts",
		"tools/**/*.ts",
		"test/*.types.ts"
	],
	"exclude": [
		"node_modules"
	]
}

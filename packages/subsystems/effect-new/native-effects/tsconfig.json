{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"lib": ["esnext"],
		"types": ["@types/web"]
	},
	"include": ["src/**/*"]
}

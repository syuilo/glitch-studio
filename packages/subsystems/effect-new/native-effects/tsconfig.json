{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"lib": ["esnext"],
		"types": ["@types/web", "vite/client", "@gs/shared/wgsl-imports"]
	},
	"include": ["src/**/*", "test/*.ts"]
}

{
	"name": "@gs/glitch-studio_desktop",
	"productName": "Glitch Studio",
	"private": true,
	"type": "module",
	"main": "main.mjs",
	"scripts": {
		"dev": "node dev.mjs",
		"start": "electron .",
		"test": "node --test test/*.test.mjs",
		"dist:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
		"dist:mac": "electron-builder --config electron-builder.config.cjs --mac dmg --arm64 --x64 --publish never",
		"build:portable": "node build-portable-custom-node-graph-effect.mjs"
	},
	"devDependencies": {
		"@electron/asar": "4.3.1",
		"electron": "45.2.1",
		"electron-builder": "26.18.0",
		"js-yaml": "5.5.0",
		"vite": "8.3.5",
		"@gs/glitch-studio_embed": "workspace:*"
	},
	"dependencies": {
		"@modelcontextprotocol/node": "2.1.2",
		"@modelcontextprotocol/server": "2.4.0",
		"electron-updater": "6.8.11",
		"semver": "7.8.6",
		"esbuild": "0.28.2",
		"mime-types": "3.0.2",
		"zod": "4.6.7"
	}
}

{
	"name": "@gs/glitch-studio_desktop",
	"productName": "Glitch Studio",
	"private": true,
	"type": "module",
	"main": "main.mjs",
	"scripts": {
		"dev": "node dev.mjs",
		"start": "electron .",
		"test": "node --test test/*.test.mjs",
		"dist:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
		"dist:mac": "electron-builder --config electron-builder.config.cjs --mac dmg --arm64 --x64 --publish never"
	},
	"devDependencies": {
		"@electron/asar": "3.4.1",
		"electron": "44.9.1",
		"electron-builder": "26.17.0",
		"js-yaml": "4.3.2",
		"vite": "8.2.2"
	},
	"dependencies": {
		"electron-updater": "6.8.10",
		"semver": "7.8.5"
	}
}

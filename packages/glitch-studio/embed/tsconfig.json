{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"strictFunctionTypes": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"rootDir": "..",
		"lib": ["esnext"],
		"types": ["@types/web", "vite/client"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "test"]
}
